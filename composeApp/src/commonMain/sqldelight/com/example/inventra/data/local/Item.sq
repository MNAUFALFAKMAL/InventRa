CREATE TABLE ItemEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category TEXT NOT NULL,
    location TEXT NOT NULL,
    status TEXT NOT NULL,
    imageUrl TEXT
);

getAllItems:
SELECT *
FROM ItemEntity;

getItemById:
SELECT *
FROM ItemEntity
WHERE id = ?;

insertItem:
INSERT OR REPLACE
INTO ItemEntity(
    id,
    name,
    category,
    location,
    status,
    imageUrl
)
VALUES (?, ?, ?, ?, ?, ?);

deleteItemById:
DELETE FROM ItemEntity
WHERE id = ?;
